prefix=/usr
libdir=${prefix}/lib
includedir=${prefix}/include

Name: tree-sitter-markdown-inline
Description: Markdown inline grammar for tree-sitter
URL: https://github.com/tree-sitter-grammars/tree-sitter-markdown
Version: 0.5.3
Requires: 
Libs: -L${libdir} -ltree-sitter-markdown-inline
Cflags: -I${includedir}
