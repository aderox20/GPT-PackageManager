#!/usr/bin/env bash

ROOT="$(cd "$(dirname "$0")" && pwd)"
PKG_DIR="$ROOT/packages"
TMP_DIR="$ROOT/tmp"
BUILD_DIR="$ROOT/build"
LOCAL_BIN="$HOME/.local/bin"
GPT_BUILD="$ROOT/tools/build_gptp.sh"

mkdir -p "$PKG_DIR" "$TMP_DIR" "$BUILD_DIR" "$LOCAL_BIN"

header() {
    clear 2>/dev/null || true
    echo "========================================"
    echo "     GPT Package Manager (GPTPM)"
    echo "========================================"
    echo ""
}

require_cmd() {
    local cmd="$1"
    if ! command -v "$cmd" &>/dev/null; then
        echo "[-] Required command not found: $cmd"
        exit 1
    fi
}

draw_progress() {
    local pkgname="$1"
    local pct="$2"

    local bar_w=34
    local fill=$((pct * bar_w / 100))
    [ "$fill" -gt "$bar_w" ] && fill=$bar_w

    local bar=""
    local i=0
    while [ $i -lt "$fill" ]; do bar="${bar}█"; i=$((i + 1)); done
    while [ $i -lt "$bar_w" ]; do bar="${bar}░"; i=$((i + 1)); done

    local pct_str
    pct_str=$(printf '%3d%%' "$pct")

    local display="$pkgname"
    [ ${#display} -gt 20 ] && display="${display:0:17}..."
    printf "\r  Downloading %-20s  %s  %s   " "$display" "$bar" "$pct_str"
}

download_single() {
    local pkgname="$1"
    local url="$2"
    local output="$3"

    local total
    total=$(curl -sIL "$url" | grep -i content-length | tail -1 | awk '{print $2}' | tr -d '\r')

    if [ -n "$total" ] && [ "$total" -gt 0 ] 2>/dev/null; then
        draw_progress "$pkgname" 0
        (
            curl -sL -o "$output" "$url"
            echo $? > "$output.ret"
        ) &
        local pid=$!
        local last_pct=-1

        while true; do
            [ -f "$output.ret" ] && break
            local downloaded=0
            [ -f "$output" ] && downloaded=$(stat -c%s "$output" 2>/dev/null || echo 0)
            local pct=$((downloaded * 100 / total))
            [ "$pct" -gt 100 ] && pct=100

            if [ "$pct" -ne "$last_pct" ]; then
                draw_progress "$pkgname" "$pct"
                last_pct=$pct
            fi

            sleep 0.1
        done

        wait "$pid" 2>/dev/null
        local ret
        ret=$(cat "$output.ret" 2>/dev/null || echo 1)
        rm -f "$output.ret"

        if [ "$last_pct" -ne 100 ]; then
            draw_progress "$pkgname" 100
        fi
        printf "\n"
        return "$ret"
    else
        draw_progress "$pkgname" 0
        printf "\n"
        curl -sfL -o "$output" "$url"
        local ret=$?
        return $ret
    fi
}

query_api() {
    local pkg="$1"
    local json
    json=$(curl -sf "https://archlinux.org/packages/search/json/?name=$pkg") || return 1
    local count
    count=$(echo "$json" | jq -r '.count // 0')
    [ "$count" -eq 0 ] && return 1
    echo "$json"
}

install_single() {
    local pkg="$1"

    local json
    json=$(query_api "$pkg") || {
        echo "  [-] Package '$pkg' not found."
        echo ""
        return 1
    }

    local repo arch pkgname version filename
    repo=$(echo "$json" | jq -r '.results[0].repo // ""')
    arch=$(echo "$json" | jq -r '.results[0].arch // "x86_64"')
    pkgname=$(echo "$json" | jq -r '.results[0].pkgname // .results[0].name // ""')
    version=$(echo "$json" | jq -r '.results[0].pkgver // .results[0].version // ""')
    filename=$(echo "$json" | jq -r '.results[0].filename // ""')

    if [ -z "$pkgname" ] || [ -z "$repo" ] || [ -z "$filename" ]; then
        echo "  [-] Incomplete package metadata."
        echo ""
        return 1
    fi

    local download_url="https://archlinux.org/packages/$repo/$arch/$pkgname/download/"

    download_single "$pkgname" "$download_url" "$TMP_DIR/$filename" || {
        echo "  [-] Download failed."
        echo ""
        return 1
    }

    local archive="$TMP_DIR/$filename"

    if [ ! -s "$archive" ]; then
        echo "  [-] Downloaded file is empty."
        rm -f "$archive"
        return 1
    fi

    echo "  ├─ Extracting $pkgname..."
    local target="$PKG_DIR/$pkgname"
    rm -rf "$target"
    mkdir -p "$target"

    tar --use-compress-program=unzstd -xf "$archive" -C "$target" || {
        echo "  [-] Extraction failed."
        return 1
    }

    if [ -d "$target/usr/bin" ]; then
        echo "  ├─ Linking binaries..."
        for b in "$target/usr/bin"/*; do
            [ -f "$b" ] || continue
            local bn
            bn=$(basename "$b")
            chmod +x "$b"
            ln -sf "$b" "$LOCAL_BIN/$bn"
        done
    fi

    echo "  └─ Building .gptp..."
    bash "$GPT_BUILD" "$pkgname" >/dev/null 2>&1

    return 0
}

install_pkg() {
    local pkg="$1"
    if [ -z "$pkg" ]; then
        echo "Usage: gpt install <package>"
        return 1
    fi

    require_cmd jq
    require_cmd curl
    require_cmd tar
    require_cmd unzstd

    header

    local json
    json=$(query_api "$pkg") || {
        echo "[-] Package '$pkg' not found."
        return 1
    }

    local pkgname deps
    pkgname=$(echo "$json" | jq -r '.results[0].pkgname // .results[0].name // ""')
    deps=$(echo "$json" | jq -r '.results[0].depends // [] | .[]' 2>/dev/null | sed 's/[><=].*//g; s/^ *//; s/ *$//' | grep -v '\.so' | sort -u)

    [ -z "$pkgname" ] && {
        echo "[-] Failed to resolve package name."
        return 1
    }

    local install_deps=()
    local dep pdep
    for dep in $deps; do
        [ -z "$dep" ] && continue
        [ -d "$PKG_DIR/$dep" ] && continue
        local skip=false
        for pdep in "${install_deps[@]}"; do
            [ "$pdep" = "$dep" ] && { skip=true; break; }
        done
        $skip && continue
        install_deps+=("$dep")
    done

    local repo version filename
    repo=$(echo "$json" | jq -r '.results[0].repo // ""')
    version=$(echo "$json" | jq -r '.results[0].pkgver // .results[0].version // ""')
    filename=$(echo "$json" | jq -r '.results[0].filename // ""')

    echo "[*] Resolving dependencies..."
    echo ""

    if [ ${#install_deps[@]} -gt 0 ]; then
        echo "    Package: $pkgname ($version)"
        echo "    Dependencies: ${install_deps[*]}"
        echo ""
    else
        echo "    Package: $pkgname ($version)"
        echo "    Dependencies: (none needed)"
        echo ""
    fi

    for dep in "${install_deps[@]}"; do
        echo "  ├─ Installing dependency: $dep"
        install_single "$dep"
        echo ""
    done

    echo "  ├─ Installing: $pkgname"
    install_single "$pkg"
    echo ""

    echo "  └─ Done"
    echo ""
    echo "[+] Package '$pkgname' installed successfully."
    echo "    Binaries linked to $LOCAL_BIN"
    echo "    Archive: build/${pkgname}-${version}.gptp"
}

remove_pkg() {
    local pkg="$1"
    if [ -z "$pkg" ]; then
        echo "Usage: gpt remove <package>"
        return 1
    fi

    header

    local target="$PKG_DIR/$pkg"
    if [ ! -d "$target" ]; then
        echo "[-] Package '$pkg' is not installed."
        return 1
    fi

    echo "[*] Removing package: $pkg"
    echo ""

    if [ -d "$target/usr/bin" ]; then
        echo "[*] Removing binary symlinks..."
        for b in "$target/usr/bin"/*; do
            [ -f "$b" ] || continue
            local bn
            bn=$(basename "$b")
            rm -f "$LOCAL_BIN/$bn"
            echo "    -> removed $bn"
        done
        echo ""
    fi

    echo "[*] Removing package files..."
    rm -rf "$target"

    for gptf in "$BUILD_DIR/$pkg"*.gptp; do
        [ -f "$gptf" ] || continue
        rm -f "$gptf"
        echo "[*] Removed .gptp: $(basename "$gptf")"
    done

    echo ""
    echo "[+] Package '$pkg' removed successfully."
}

list_pkg() {
    header
    echo "[*] Installed packages:"
    echo ""

    local count=0
    for d in "$PKG_DIR"/*/; do
        [ -d "$d" ] || continue
        local name
        name=$(basename "$d")
        local ver="?"
        if [ -f "$d/.PKGINFO" ]; then
            ver=$(grep '^pkgver' "$d/.PKGINFO" 2>/dev/null | sed 's/pkgver = //' | head -1)
            [ -z "$ver" ] && ver="?"
        fi
        printf "    %-24s %s\n" "$name" "$ver"
        count=$((count + 1))
    done

    if [ "$count" -eq 0 ]; then
        echo "    (no packages installed)"
    fi
    echo ""
}

version() {
    echo "GPT Package Manager v1.0.0"
}

help() {
    header
    echo "Usage: gpt <command> [<args>]"
    echo ""
    echo "Commands:"
    echo "    install <pkg>    Install a package from Arch Linux"
    echo "    remove <pkg>     Remove an installed package"
    echo "    list             List installed packages"
    echo "    version          Show version information"
    echo "    help             Show this help message"
    echo ""
}

case "${1:-help}" in
    install) install_pkg "$2" ;;
    remove)  remove_pkg "$2" ;;
    list)    list_pkg ;;
    version) version ;;
    help)    help ;;
    *)
        echo "Unknown command: $1"
        echo "Usage: gpt <install|remove|list|version|help>"
        exit 1
        ;;
esac
